{
    // General settings
    "layer": "top",
    "position": "top",
    "margin-bottom": 0,
    "margin-top": 4,
    "spacing": 2,

    // Left modules
    "modules-left": [
        "custom/arch",
        "clock",
        "hyprland/window",
        "tray"
    ],

    // Middle modules
    "modules-center": [
        "hyprland/workspaces"
    ],

    // Right modules
    "modules-right": [
        "idle_inhibitor",
        "wireplumber",
        "network",
        "group/hardware",
        "group/grp-power"
    ],

    // Hyprland utils
    "hyprland/workspaces": {
        "sort-by-name": false,
        "sort-by-coordinates": true,
        "on-click": "activate",
        "persistent-workspaces": {
            "HDMI-A-2": 5,
            "DP-3": [5]
        }
    },

    "hyprland/window": {
        "format": "{}",
        "icon": true,
        "icon-size": 20,
        "max-length": 32,
        "separate-outputs": true
    },

    // Clock
    "clock": {
        "locale": "C", 
        "format": "   {:%I:%M %p}",
        "format-alt": "   {:%A, %d %b}" // Icon: calendar-alt
    },

    // Group/Hardware
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },

    "cpu": {
        "format": "&#8239;  {usage}%",
        "tooltip": false,
        "on-click": "kitty -e 'btop'"
    },
    
    "memory": {
        "interval": 30,
        "format": "  {used:0.2f}GB",
        "max-length": 10,
        "tooltip": false,
        "warning": 70,
        "critical": 90,
        "on-click": "kitty -e 'btop'"
    },

    // Network
    "network": {
        "interval": 2,
        "format-wifi": "    {essid}",
        "format-ethernet": "",
        "format-linked": "{ipaddr}/{cidr}",
        "format-disconnected": "   Disconnected",
        "format-disabled": "",
        "tooltip": false,
        "min-length": 6,
        "format-alt": "  {bandwidthUpBytes} /   {bandwidthDownBytes} ({ipaddr}/{cidr})"
    },
    
    // Idle
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    // Audio
    "wireplumber": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}   {volume}%  {format_source}",
        "format-bluetooth": "{icon}   {volume}%  {format_source}",
        "format-bluetooth-muted": "   {format_source}",
        "format-muted": "   {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pwvucontrol"
    },

    // System tray
    "tray": { 
        "icon-size": 21,
        "spacing": 4
    },

    // Custom modules
    // Arch
    "custom/arch": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "btw"
    },

    // Power
    "group/grp-power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false,
        },
        "modules": [
            "custom/power",
            "custom/lock",
            "custom/sleep",
            "custom/reboot"
        ]
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "poweroff"
    }, 

    "custom/reboot": {
        "format": "",
        "tooltip": false,
        "on-click": "reboot"
    },

    "custom/sleep": {
        "format": "󰤄",
        "tooltip": false,
        "on-click": "loginctl lock-session && systemctl suspend"
    },

    "custom/lock": {
        "format": "",
        "tooltip": false,
        "on-click": "loginctl lock-session"
    }
}
