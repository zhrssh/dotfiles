
/* ============================================================
   COLOR VARIABLES
   ============================================================ */

@define-color fg-default            whitesmoke;
@define-color bg-transparent        transparent;

/* Dark block */
@define-color block-bg              rgba(52, 58, 64, 0.8);
@define-color block-border          rgba(33, 37, 41, 1);

/* Accents */
@define-color yellow-accent         rgba(255, 209, 102, 1);
@define-color gray-accent           rgba(206, 212, 218, 1);

@define-color green-accent          rgba(6, 214, 160, 1);
@define-color green-accent-bg       rgba(6, 214, 160, 0.9);
@define-color green-accent-dark     rgba(7, 59, 76, 0.9);

@define-color red-accent            rgba(239, 71, 111, 1);
@define-color red-accent-bg         rgba(239, 71, 111, 0.9);
@define-color red-accent-soft       rgba(239, 71, 111, 0.1);

@define-color gray-muted            rgba(108, 117, 125, 1);
@define-color gray-muted-bg         rgba(108, 117, 125, 0.8);


/* ============================================================
   GLOBAL & BASE RULES
   ============================================================ */

* {
    font-family: Josefin Sans;
    font-size: 14px;
    min-height: 16px;
    color: @fg-default;
    background-color: @bg-transparent;
}


/* ============================================================
   GLOBAL SPACING
   ============================================================ */

#custom-arch,
#clock,
#idle_inhibitor,
#network,
#wireplumber {
    margin-right: 2px;
}


/* ============================================================
   MODULE BLOCK CONTAINERS
   ============================================================ */

#window,
#hardware,
#wireplumber,
#network,
#clock {
    background-color: @block-bg;
    border-radius: 16px;
    border: 2px solid @block-border;
    padding-left: 12px;
    padding-right: 12px;
}

window#waybar.empty #window {
    background: none;
    border: none;
}

#window label {
    margin-top: 4px;
}

/* ============================================================
   MODULE COLORS / STATUS COLORS
   ============================================================ */

#hardware label {
    color: @yellow-accent;
}

#idle_inhibitor {
    color: @gray-accent;
    padding-right: 12px;
}

#network {
    color: @green-accent;
}

#network.disconnected {
    color: @red-accent;
}

#network.disabled {
    color: @gray-muted;
}


/* ============================================================
   HARDWARE GROUP SUB-ELEMENTS
   ============================================================ */

#hardware *:not(:first-child) label {
    margin-left: 12px;
}


/* ============================================================
   WORKSPACES
   ============================================================ */

/* Workspace animation */
@keyframes workspacesAnim {
    from {
        background-color: @green-accent-dark;
        padding: 4px 12px;
    }
    to {
        background-color: @green-accent-bg;
        padding: 4px 28px;
    }
}

#workspaces label {
    margin-top: 4px;
    margin-bottom: 0;
}

#workspaces button {
    border-radius: 16px;
    margin-right: 12px;
    padding: 4px 12px;
    font-weight: normal;
    background-color: @green-accent-dark;
}

#workspaces button:hover {
    box-shadow: inherit;
    text-shadow: none;
    background: @green-accent-dark;
    transition: none;
}

#workspaces button.active,
#workspaces button.focused {
    animation-name: workspacesAnim;
    animation-duration: 0.25s;
    background: @green-accent-bg;
    padding: 4px 28px;
    color: @green-accent-dark;
    font-weight: bolder;
}


/* ============================================================
   ARCH LOGO / TITLE MODULE
   ============================================================ */

#custom-arch {
    font-size: 22px;
    color: @green-accent-bg;
    margin-left: 16px;
    margin-right: 8px;
}


/* ============================================================
   POWER BUTTON + POWER GROUP
   ============================================================ */

/* Power animation */
@keyframes powerAnim {
    from {
        color: @red-accent-bg;
        background-color: transparent;
    }
    to {
        color: @fg-default;
        background-color: @red-accent-bg;
    }
}

#custom-power {
    color: @red-accent-bg;
    background-color: @red-accent-soft;
    border: 2px solid @red-accent-bg;
    font-size: 20px;
    font-weight: bolder;
    margin-right: 12px;
    padding: 0 10px;
    border-radius: 16px;
    transition: border-radius 0.25s;
}

#grp-power:hover > :last-child :not(.not-power) {
    animation: powerAnim 0.25s;
    color: @fg-default;
    background-color: @red-accent-bg;
    border-radius: 0 16px 16px 0;
}

#grp-power .not-power {
    background-color: @block-bg;
    border: 2px solid @block-border;
}

#grp-power .not-power:first-child {
    border-radius: 16px 0 0 16px;
}

#grp-power .not-power > * {
    margin-right: 4px;
    padding-left: 16px;
    padding-right: 16px;
}

#grp-power .not-power > *:hover {
    border-radius: inherit;
    background-color: @gray-muted-bg;
}

